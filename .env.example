# Domain & Reverse Proxy
DOMAIN_NAME=demo.yourdomain.com
APP_PORT=8000

# FalkorDB Credentials
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your_falkordb_password
FALKORDB_SSL=false
FALKORDB_GRAPH=graphcortex
FALKORDB_GRAPH_TEST=graphcortex_test

# PostgreSQL Credentials (Guest Authentication & Quota Engine)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=graphcortex
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:your_postgres_password@your_postgres_host:5432/graphcortex

# Guest Sandbox Quotas & Security
MAX_CONCURRENT_GUESTS=50
GUEST_SESSION_LIMIT=10
GUEST_TTL_HOURS=24

# Local Development Identity
DEMO_USER_ID=demo-user-herbert
DEFAULT_PROJECT_ID=proj-payment-reliability
LOG_LEVEL=INFO
