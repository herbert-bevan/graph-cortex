# Domain & Reverse Proxy
DOMAIN_NAME=demo.yourdomain.com

# FalkorDB Credentials
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=replace_with_a_strong_falkordb_password
FALKORDB_SSL=false
FALKORDB_GRAPH=graphcortex_production

# PostgreSQL Credentials (Guest Authentication & Quota Engine)
POSTGRES_USER=mcp_admin
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
POSTGRES_DB=graphcortex_auth_db
DATABASE_URL=postgresql://mcp_admin:replace_with_a_strong_postgres_password@postgres:5432/graphcortex_auth_db

# Guest Sandbox Quotas & Security
MAX_CONCURRENT_GUESTS=50
GUEST_SESSION_LIMIT=10
GUEST_TTL_HOURS=24

# Local Development Overrides
DEMO_USER_ID=demo-user-herbert
DEFAULT_PROJECT_ID=proj-payment-reliability-2026
LOG_LEVEL=INFO
