      "label": "Incident",
      "id": "inc-pay-042",
      "name": "Payment Timeout Incident",
      "code": "INC-PAY-042",
      "aliases": ["INC-PAY-042"],
      "properties": {
        "severity": "SEV-1",
        "occurred_at": "2026-03-01T14:22:00Z"
      }
    },
    {
      "label": "Incident",
      "id": "inc-pay-019",
      "name": "Duplicate Charge Incident",
      "code": "INC-PAY-019",
      "aliases": ["INC-PAY-019"],
      "properties": {
        "severity": "SEV-2",
        "occurred_at": "2026-01-20T09:15:00Z"
      }
    },
    {
      "label": "Decision",
      "id": "adr-014",
      "name": "ADR-014: Use idempotency keys",
      "aliases": ["ADR-014", "idempotency keys", "idempotency key"],
      "properties": {
        "status": "accepted",
        "decided_on": "2026-02-10",
        "rationale": "Clients retried create-payment calls after timeouts, causing duplicate charges (INC-PAY-019). Idempotency keys let PaymentService deduplicate repeated requests within a 24h window."
      }
    },
    {
      "label": "Decision",
      "id": "adr-021",
      "name": "ADR-021: Bounded exponential backoff",
      "aliases": ["ADR-021", "exponential backoff"],
      "properties": {
        "status": "accepted",
        "decided_on": "2026-03-05",
        "rationale": "Unbounded immediate retries amplified load during INC-PAY-042. Retries use exponential backoff with jitter and a hard cap of 5 attempts."
      }
    },
    {
      "label": "Decision",
      "id": "adr-027",
      "name": "ADR-027: Standardize connection-pool limits",
      "aliases": ["ADR-027", "connection pool"],
      "properties": {
        "status": "accepted",
        "decided_on": "2026-03-20",
        "rationale": "Pool exhaustion contributed to timeouts; standard limits and monitoring added."
      }
    },
    {
      "label": "Document",
      "id": "doc-adr-014",
      "name": "ADR-014 Idempotency Keys",
      "properties": {
        "uri": "graphcortex://docs/adr-014",
        "doc_type": "adr",
        "excerpt": "Architecture Decision Record detailing idempotency key design for PaymentService to deduplicate retried API calls and eliminate duplicate charges."
